<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:mvc="http://www.springframework.org/schema/mvc"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           https://www.springframework.org/schema/beans/spring-beans.xsd
           http://www.springframework.org/schema/context
           https://www.springframework.org/schema/context/spring-context.xsd
           http://www.springframework.org/schema/mvc
           https://www.springframework.org/schema/mvc/spring-mvc.xsd">

    <!-- Activer la détection automatique des composants -->
    <context:component-scan base-package="ma.youcode.click"/>

    <!-- Activer les annotations Spring MVC -->
    <mvc:annotation-driven/>

    <bean id="publisherRepository" 
        class="ma.youcode.click.repository.imp.PublisherRepositoryImpl"/>
    <bean id="publisherService"
          class="ma.youcode.click.service.PublisherService">
        <constructor-arg ref="publisherRepository"/>
    </bean>

    <bean id="repository" 
        class="ma.youcode.click.repository.imp.LienRepositoryImpl"/>
    <bean id="lienService"
             class="ma.youcode.click.service.LienService">
        <constructor-arg ref="repository"/>
        <constructor-arg ref="publisherRepository"/>
    </bean>

</beans>
